# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment & secrets
.env
.env.local
.env.production

# Testing
.pytest_cache/
htmlcov/
coverage.xml
.coverage
junit.xml
diff-cover.html
diff-cover.md

# Mutation testing — mutants/ is the throwaway tree mutmut copies the source
# into; reports are regenerated (baseline lives in docs/TEST_QUALITY.md).
mutants/
.mutmut-cache
mutation-report.json
mutation-report.md

# Linting
.ruff_cache/
.mypy_cache/

# Models (large, regenerated)
models/*.pkl
models/*.joblib

# SQLite cache (regenerated from APIs)
# The -shm/-wal sidecars are rewritten on every open, so tracking them
# makes the working tree go dirty just from running the test suite.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Holdout-metrics export (regenerated from GCS every training run — numbers
# live in docs/BACKTEST_RESULTS.md, not in git). See scripts/export_holdout_metrics.py
holdout_metrics.csv
docs/_holdout_table.md

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Internal strategy note — explicitly not for publication
docs/internal/MARKET_POSITION.md
